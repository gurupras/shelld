+    /// Relative vertical cursor movement, shared by CUU, CUD, CPL and CNL.
+    ///
+    /// The scrolling region bounds where a relative move may leave the cursor, and
+    /// it does so whether or not ORIGIN is set: a cursor inside the region stays
+    /// inside it, and one outside is bounded by the screen and may move into it.
+    /// ORIGIN changes what an absolute row number counts from, which is a different
+    /// question from where the cursor may go.
+    ///
+    /// These do not go through goto(), whose ORIGIN offset translates the coordinate
+    /// system absolute addressing counts in. Applied to a distance it displaces
+    /// every relative move by the region's top row.
+    #[inline]
+    fn move_vertically(&mut self, lines: i32) {
+        let cur = self.grid.cursor.point.line.0;
+        let lo = if cur >= self.scroll_region.start.0 { self.scroll_region.start.0 } else { 0 };
+        let hi = if cur < self.scroll_region.end.0 {
+            self.scroll_region.end.0 - 1
+        } else {
+            self.bottommost_line().0
+        };
+        self.damage_cursor();
+        self.grid.cursor.point.line = Line(cmp::max(cmp::min(cur + lines, hi), lo));
+        self.damage_cursor();
+        self.grid.cursor.input_needs_wrap = false;
+    }
+
